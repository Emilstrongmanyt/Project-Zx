# Unity .gitattributes Template
# Source: https://github.com/gitattributes/gitattributes/blob/master/Unity.gitattributes
# Last synced: 2026-02-04
# License: MIT
#
# Binary game assets are stored as normal Git blobs (not Git LFS) so CI/TestFlight
# is not blocked by GitHub LFS storage/bandwidth quotas.

[attr]unity-json        eol=lf linguist-language=json
[attr]unity-yaml        merge=unityyamlmerge eol=lf linguist-language=yaml

# Unity source files
*.cginc                 text
*.compute               text linguist-language=hlsl
*.cs                    text diff=csharp
*.hlsl                  text linguist-language=hlsl
*.raytrace              text linguist-language=hlsl
*.shader                text

# Unity JSON files
*.asmdef                unity-json
*.asmref                unity-json
*.index                 unity-json
*.inputactions           unity-json
*.shadergraph           unity-json
*.shadersubgraph        unity-json

# Unity UI Toolkit files
*.tss                   text diff=css linguist-language=css
*.uss                   text diff=css linguist-language=css
*.uxml                  text linguist-language=xml linguist-detectable

# Unity YAML files
*.anim                  unity-yaml
*.asset                 unity-yaml
*.brush                 unity-yaml
*.controller            unity-yaml
*.flare                 unity-yaml
*.fontsettings          unity-yaml
*.giparams              unity-yaml
*.guiskin               unity-yaml
*.lighting              unity-yaml
*.mask                  unity-yaml
*.mat                   unity-yaml
*.meta                  unity-yaml
*.mixer                 unity-yaml
*.overrideController    unity-yaml
*.playable              unity-yaml
*.prefab                unity-yaml
*.preset                unity-yaml
*.renderTexture         unity-yaml
*.scenetemplate         unity-yaml
*.shadervariants        unity-yaml
*.signal                unity-yaml
*.spriteatlas           unity-yaml
*.spriteatlasv2         unity-yaml
*.terrainlayer          unity-yaml
*.unity                 unity-yaml
*.physicMaterial        unity-yaml
*.physicsMaterial2D     unity-yaml

# Exclude from GitHub stats and diffs
Assets/Plugins/**           linguist-generated
Packages/packages-lock.json linguist-generated

# Binary assets — normal Git (not LFS)
*.png !text !filter !merge !diff
*.jpg !text !filter !merge !diff
*.jpeg !text !filter !merge !diff
*.gif !text !filter !merge !diff
*.webp !text !filter !merge !diff
*.bmp !text !filter !merge !diff
*.tga !text !filter !merge !diff
*.psd !text !filter !merge !diff
*.tif !text !filter !merge !diff
*.tiff !text !filter !merge !diff
*.mp3 !text !filter !merge !diff
*.wav !text !filter !merge !diff
*.ogg !text !filter !merge !diff
*.aif !text !filter !merge !diff
*.aiff !text !filter !merge !diff
*.mp4 !text !filter !merge !diff
*.mov !text !filter !merge !diff
*.avi !text !filter !merge !diff
*.fbx !text !filter !merge !diff
*.obj !text !filter !merge !diff
*.blend !text !filter !merge !diff
*.dll !text !filter !merge !diff
*.so !text !filter !merge !diff
*.exe !text !filter !merge !diff
*.apk !text !filter !merge !diff
*.zip !text !filter !merge !diff
*.7z !text !filter !merge !diff
*.gz !text !filter !merge !diff
*.tar !text !filter !merge !diff
*.rar !text !filter !merge !diff
*.pdf !text !filter !merge !diff
*.ttf !text !filter !merge !diff
*.otf !text !filter !merge !diff
*.cubemap !text !filter !merge !diff
*.unitypackage !text !filter !merge !diff

LightingData.asset     binary
